# Copy to .env.local for development. Both values are public by design: they
# end up in the JavaScript bundle. Access is decided by the database functions.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
# Domain appended to usernames to form the Supabase Auth email.
VITE_LOGIN_DOMAIN=pit-control.local

# NEVER put the service_role / secret key in this file, in the repository or in
# GitHub Actions. Export it only in your own shell when running create-user:
#   SUPABASE_SERVICE_ROLE_KEY=... npm run create-user -- nombre staff
